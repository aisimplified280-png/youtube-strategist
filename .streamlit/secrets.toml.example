# Copy these settings into Streamlit Community Cloud's app Secrets.
# Use an OAuth 2.0 Web application client from Google Cloud.
# Both Google OAuth flows use the deployed Streamlit Cloud route prefix.
# The built-in sign-in callback uses /~/+/oauth2callback; the app's separate
# YouTube API callback uses /~/+/. Both URLs must be registered in Google Cloud.
# Local development uses http://localhost:8501/oauth2callback and http://localhost:8501/.

[auth]
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/~/+/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_WEB_OAUTH_CLIENT_ID"
client_secret = "YOUR_WEB_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile", prompt = "select_account" }

[access]
owner_email = "YOUR_GOOGLE_ACCOUNT_EMAIL"

[youtube_oauth]
client_id = "YOUR_WEB_OAUTH_CLIENT_ID"
client_secret = "YOUR_WEB_OAUTH_CLIENT_SECRET"
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/~/+/"

[security]
state_secret = "REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"

# Primary AI provider for channel reasoning and metadata proposals: Gemini.
# Configure the same GEMINI_API_KEY as a Streamlit Cloud secret and a GitHub Actions repository secret.
# Gemini developer API access/billing is separate from a consumer Gemini subscription.
[gemini]
api_key = "YOUR_GEMINI_API_KEY"
model = "gemini-4-argon"
fallback_models = ["gemini-3.8-flash"]

# Optional provider fallback if Gemini cannot complete a request.
# Keep this key private; it is never sent to the browser.
[groq]
api_key = "YOUR_GROQ_API_KEY"
model = "openai/gpt-oss-120b"
fallback_models = []
